# Image Processor Configuration (RADCURE / HECKTOR)
# Copy this file to .env and fill in your actual credentials
# Never commit .env to version control!
#
# Package: image_processor (dataset-agnostic: RADCURE, HECKTOR)
# To use: cp env.example .env
# Then edit .env with your actual credentials

# ============================================================================
# AWS Credentials (Required for processing)
# ============================================================================
AWS_ACCESS_KEY_ID=your_access_key_id_here
AWS_SECRET_ACCESS_KEY=your_secret_access_key_here
AWS_REGION=eu-west-1

# ============================================================================
# Dataset Configuration (Required for RADCURE processing)
# ============================================================================
MAIN_PATH=/path/to/your/dataset/RadcureComplete/
AWS_BUCKET_NAME=your-bucket-name
AWS_FOLDER=RADCURE/all_cases/

# For HECKTOR: root folder containing case folders (e.g. .../Hecktor/cases)
# CASES_ROOT=/path/to/Hecktor/cases

# ============================================================================
# Processing Configuration (Optional)
# ============================================================================
ORGAN_DICTIONARY_PATH=/path/to/radcure_dictionary.json
# (Shared by RADCURE and HECKTOR; GTVp = tumor index in combined mask)
PROCESSED_CASES_FILE=/path/to/processed_cases.txt
FAILED_CASES_FILE=/path/to/processed_cases_failed.txt
REVERSE_SLICES=False
SLICE_EXPANSION=5

# ============================================================================
# nnUNet Training Configuration (Required for training)
# ============================================================================
# Path to your DatasetXXX_TotalSegmentator folder (created by split_dataset.py)
# This folder should contain: imagesTr, imagesTs, imagesVa, labelsTr, labelsTs, labelsVa
DATASET_FOLDER=/path/to/DatasetXXX_TotalSegmentator/

# Path to nnUNet installation (optional, has default)
NNUNET_PATH=/path/to/nnUNet

# Base path for nnUNet raw/preprocessed/results folders (optional, has default)
NNUNET_RETRAIN_PATH=/path/to/nnunet_retrain

# Override auto-detected dataset ID (optional)
# DATASET_ID=150

# Training configuration (optional)
NNUNET_CONFIGURATION=3d_fullres
NNUNET_TRAINER=nnUNetTrainerNoMirroring
# Test3 (700 epochs, no mirroring): NNUNET_TRAINER=nnUNetTrainer_700epochs_NoMirroring
# Reuse preprocessing from a previous run without re-planning (Test3 only — not Test4):
# NNUNET_PREPROCESSED_PATH=/path/to/previous_retrain/nnUNet_preprocessed
# Force local preprocess even when the line above is set in .env (Test4):
# NNUNET_USE_LOCAL_PREPROCESS=1
NNUNET_FOLD=0
NNUNET_NUM_PROCESSES=1

# nnUNet runtime (optional — read directly by nnUNet, not by TrainingConfig)
# Pin training to one GPU when the other is in use (physical GPU index):
# CUDA_VISIBLE_DEVICES=1
# Disable torch.compile if training OOMs on epoch 0 (common on 24GB GPUs with batch_size 2):
# nnUNet_compile=false
# Fewer data-augmentation workers if CPU/RAM is tight:
# nnUNet_n_proc_DA=4

# Write test predictions / eval viz outside DATASET_FOLDER (optional):
# NNUNET_EVAL_OUTPUT_DIR=/path/to/output_folder
# HECKTOR_EVAL_OUTPUT_DIR=/path/to/nnunet_radheck_test_3_retrain/hecktor_validation

# Prediction configuration (optional)
NNUNET_DISABLE_TTA=True
NNUNET_PREDICTION_FOLD=0

# Evaluation configuration (optional)
EVALUATION_NUM_CPUS=8
SURFACE_DICE_TOLERANCE=3.0

# Logging directory (optional)
LOG_DIR=./logs

